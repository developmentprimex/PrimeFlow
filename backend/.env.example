# Copy to backend/.env and set values
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/primex_nexus
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
APP_TIMEZONE=Europe/Budapest
SYSTEM_TASK_SCHEDULER_ENABLED=true
SYSTEM_TASK_SCHEDULER_DAY_OF_WEEK=fri
SYSTEM_TASK_SCHEDULER_HOUR=6
SYSTEM_TASK_SCHEDULER_MINUTE=0
SYSTEM_TASK_GENERATE_AHEAD_DAYS=7
SYSTEM_TASK_DAILY_RECONCILE_HOUR=6
SYSTEM_TASK_DAILY_RECONCILE_MINUTE=5

JWT_SECRET=change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated list
CORS_ORIGINS=http://localhost:3000

# Central Files PX storage on the server. Paths copied from the mapped Y: drive
# or its UNC share are translated to the server-local F:\FILES path.
FILES_SERVER_STORAGE_ROOT=F:\FILES
FILES_SERVER_PATH_ALIASES=Y:;F:\FILES;\\192.168.10.8\FILES

# Shared Microsoft calendar. An admin connects this account once in Meeting Scheduler.
MS_CLIENT_ID=
MS_TENANT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:8000/api/microsoft/callback
MS_ORGANIZER_EMAIL=info@primexeu.com
MS_CALENDAR_SYNC_ENABLED=true
MS_CALENDAR_SYNC_INTERVAL_MINUTES=5
# The window starts Monday of the current week. 14 means two additional weeks;
# each included week ends on Friday.
MS_CALENDAR_SYNC_PAST_DAYS=0
MS_CALENDAR_SYNC_FUTURE_DAYS=14
MS_CALENDAR_DEFAULT_DEPARTMENT_CODE=DEV

# Optional: enable cloud speech-to-text
OPENAI_API_KEY=
VOICE_ASSISTANT_MODEL=gpt-realtime-2.1
VOICE_ASSISTANT_VOICE=marin

# Personal Discord assistant (opt-in; worker runs separately)
DISCORD_ASSISTANT_ENABLED=false
DISCORD_BRIDGE_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CATEGORY_ID=
DISCORD_MEETING_VOICE_CHANNEL_ID=
DISCORD_MESSAGE_CONTENT_ENABLED=false
DISCORD_AI_MODEL=gpt-5.4-mini
DISCORD_AI_TIMEOUT_SECONDS=45
SKILLS_AI_MODEL=gpt-5.4-nano
SKILLS_AI_TIMEOUT_SECONDS=20
SPEECH_TRANSCRIBE_MODEL=whisper-1
SPEECH_MAX_FILE_MB=20
# Comma-separated list, e.g. audio/webm,audio/wav,audio/mp4
SPEECH_ALLOWED_MIME=

# Daily/weekly realization snapshots and optional AI evidence summary
REALIZATION_TIMEZONE=Europe/Tirane
REALIZATION_DAILY_ENABLED=true
REALIZATION_DAILY_HOUR=16
REALIZATION_DAILY_MINUTE=20
REALIZATION_AI_ENABLED=false
REALIZATION_AI_MODEL=gpt-5.2
REALIZATION_AI_TIMEOUT_SECONDS=45
REALIZATION_DAILY_REPORT_AI_ENABLED=false
REALIZATION_DAILY_REPORT_AI_MODEL=gpt-5.4-mini
REALIZATION_DAILY_REPORT_AI_TIMEOUT_SECONDS=30

# PrimeFlow MCP and dedicated 1H report scheduler
PRIMEFLOW_API_BASE_URL=http://127.0.0.1:8000
PRIMEFLOW_MCP_HOST=0.0.0.0
PRIMEFLOW_MCP_PORT=8010
PRIMEFLOW_MCP_URL=http://127.0.0.1:8010/sse
PRIMEFLOW_EMAIL=
PRIMEFLOW_PASSWORD=
# Optional alternative to email/password (short-lived tokens are not recommended in production)
PRIMEFLOW_ACCESS_TOKEN=
PRIMEFLOW_REPORT_TIMEZONE=Europe/Tirane
PRIMEFLOW_REPORT_RECIPIENTS=130primex.eu@gmail.com,ga@primexeu.com
TOMORROW_PRINT_REPORT_SCHEDULER_ENABLED=true
TODAY_PRINT_REPORT_SCHEDULER_ENABLED=true
# API-owned scheduled reports; set false for local development.
REPORT_SCHEDULERS_ENABLED=true
STD_PRIMEFLOW_API_TOKEN=
# Gmail SMTP (use a Google app password, not the normal account password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# Weekly Planning Audit Report (Celery worker + Celery Beat)
WEEKLY_PLANNING_AUDIT_ENABLED=true
WEEKLY_PLANNING_AUDIT_TIMEZONE=Europe/Tirane
WEEKLY_PLANNING_AUDIT_RECIPIENTS=130primex.eu@gmail.com,info@primexeu.com,ga@primexeu.com
# PX JAV weekly report (Thursday at 15:50)
PX_JAV_WEEKLY_REPORT_ENABLED=true
PX_JAV_WEEKLY_REPORT_TIMEZONE=Europe/Tirane
PX_JAV_WEEKLY_REPORT_RECIPIENT=334primex.eu@gmail.com
REPORT_STORAGE_DIR=uploads/reports
REPORT_RETENTION_DAYS=90


